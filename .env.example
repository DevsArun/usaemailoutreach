# ============================================
# LeadForge AI — Environment Configuration
# ============================================

# Server
NODE_ENV=production
PORT=7860
FRONTEND_URL=http://localhost:7860

# Database (PostgreSQL)
DATABASE_URL=postgres://leadforge:leadforge_secret@localhost:5432/leadforge_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadforge_db
DB_USER=leadforge
DB_PASSWORD=leadforge_secret

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Groq AI API Keys (up to 5, rotated automatically)
GROQ_API_KEY_1=gsk_your_key_1
GROQ_API_KEY_2=gsk_your_key_2
GROQ_API_KEY_3=gsk_your_key_3
GROQ_API_KEY_4=gsk_your_key_4
GROQ_API_KEY_5=gsk_your_key_5
GROQ_MODEL=llama-3.3-70b-versatile

# Python Scraper Service
SCRAPER_SERVICE_URL=http://localhost:8000

# Email Verification (optional external provider)
EMAIL_VERIFY_PROVIDER=builtin
EMAIL_VERIFY_API_KEY=

# ─── Email Sending Transport ─────────────────────────────────────────
# Hugging Face Spaces / Render / Railway BLOCK outbound SMTP ports
# (25, 465, 587), so raw SMTP times out ("Connection timeout").
# To send email on these platforms, use an HTTP API provider over HTTPS.
#
# Leave EMAIL_HTTP_PROVIDER empty to use normal SMTP (works on a VPS).
# Set it to "brevo" or "resend" to send via HTTPS instead.
#   - Brevo:  free ~300 emails/day  -> https://app.brevo.com  (Settings > SMTP & API > API Keys)
#   - Resend: free ~100 emails/day  -> https://resend.com/api-keys
#
# IMPORTANT: To send FROM your own address (e.g. info@devsarun.io) you must
# verify/authenticate the domain devsarun.io in the provider dashboard
# (add the SPF + DKIM DNS records they give you).
EMAIL_HTTP_PROVIDER=
BREVO_API_KEY=
RESEND_API_KEY=

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Campaign Defaults
DEFAULT_DAILY_EMAIL_LIMIT=50
DEFAULT_FOLLOWUP_DELAY_1=3
DEFAULT_FOLLOWUP_DELAY_2=5
DEFAULT_FOLLOWUP_DELAY_3=7
MAX_FOLLOWUPS=3

# Gap (in seconds) between consecutive outreach emails in a bulk send.
# Spacing emails out (instead of one big burst) improves inbox placement.
# Overridden per-user by the "email_delay_seconds" setting in the app.
EMAIL_SEND_GAP_SECONDS=30

# Proxy (optional)
PROXY_ENABLED=false
PROXY_LIST=
